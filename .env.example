# Copy to .env and adjust. docker compose reads .env automatically. Never commit .env.
SPRING_PROFILES_ACTIVE=dev
# run.bat also reads this file: set DB_USERNAME / DB_PASSWORD to a login on your local MySQL.
# The tickethub database is created on first start if that login is allowed to create it.
DB_USERNAME=tickethub
DB_PASSWORD=tickethub
# DB_URL=jdbc:mysql://localhost:3306/tickethub?createDatabaseIfNotExist=true
# Windows service run.bat starts if MySQL is stopped.
MYSQL_SERVICE=MySQL80
# Root password for the docker compose MySQL container only.
MYSQL_ROOT_PASSWORD=root
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-256-bit-secret-in-env
APP_CORS_ORIGIN=http://localhost:5173
APP_FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8080
GRAFANA_PASSWORD=admin
# Sprint 4
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
